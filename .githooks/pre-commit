#!/usr/bin/env bash
#
# pre-commit: 自动标准化 BOM、换行符和编码
#
#   - 调用 scripts/normalize-text.ps1
#   - 如果 ps1 脚本修改了文件，自动 git add 回去
#   - 如果 ps1 不存在或 PowerShell 不可用，静默跳过（不阻塞 commit）
#
# 安装： git config core.hooksPath .githooks
# 绕过： git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/normalize-text.ps1"

# 脚本不存在？跳过
if [ ! -f "$SCRIPT" ]; then
    exit 0
fi

# 找 pwsh 或 powershell
if command -v pwsh &>/dev/null; then
    PS_BIN="pwsh"
elif command -v powershell &>/dev/null; then
    PS_BIN="powershell"
else
    echo "[pre-commit] No PowerShell found, skipping normalize-text hook."
    exit 0
fi

echo "[pre-commit] Normalizing line endings and BOM..."

# 收集 staged 的文件路径（相对 repo root）
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMRT)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

# 把路径用管道拼起来传给 PowerShell
PATH_LIST=""
for f in "${STAGED_FILES[@]}"; do
    abs="$REPO_ROOT/$f"
    if [ -f "$abs" ]; then
        PATH_LIST+="|$abs"
    fi
done
PATH_LIST="${PATH_LIST#|}"  # 去掉开头的管道符

if [ -z "$PATH_LIST" ]; then
    exit 0
fi

# 执行标准化
OUTPUT="$($PS_BIN -NoLogo -NoProfile -ExecutionPolicy Bypass \
    -File "$SCRIPT" -Paths "$PATH_LIST" 2>&1 || true)"

echo "$OUTPUT"

# 检查有没有 FIXED 输出（说明脚本改了文件）
if echo "$OUTPUT" | grep -q "FIXED:"; then
    echo "[pre-commit] Re-staging normalized files..."
    # 重新 add 所有 staged 文件（包括被修改的）
    git add "${STAGED_FILES[@]}"
fi

exit 0
