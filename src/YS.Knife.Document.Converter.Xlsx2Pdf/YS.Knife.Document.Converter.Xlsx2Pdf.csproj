<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibreOfficeKit (netstandard2.0) pulls in net10-era BCL packages; their buildTransitive
         targets emit NETStandardCompat warnings that are expected and harmless. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="YS.Knife" />
    <ProjectReference Include="..\YS.Knife.DependencyInjection\YS.Knife.DependencyInjection.csproj" />
    <PackageReference Include="LibreOfficeKit" Version="1.1.7" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YS.Knife.Document.Core\YS.Knife.Document.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="YS.Knife.Document.Converter.Xlsx2Pdf.UnitTest" />
  </ItemGroup>
</Project>
