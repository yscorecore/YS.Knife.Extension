<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibreOfficeKit (netstandard2.0) pulls in net10-era BCL packages; their buildTransitive
         targets emit NETStandardCompat warnings on net6.0 that are expected and harmless. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="YS.Knife" />
    <PackageReference Include="YS.Knife.Core" Version="2.0.2" />
    <PackageReference Include="LibreOfficeKit" Version="1.1.7" />
    <!-- 覆盖 LibreOfficeKit 传递的 net10-only 依赖，兼容 net6/net8/net9 runtime -->
    <PackageReference Include="System.Text.Json" Version="8.0.5">
      <NoWarn>NU1605</NoWarn>
    </PackageReference>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YS.Knife.Document.Core\YS.Knife.Document.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="YS.Knife.Document.Converter.Xlsx2Pdf.UnitTest" />
  </ItemGroup>
</Project>
