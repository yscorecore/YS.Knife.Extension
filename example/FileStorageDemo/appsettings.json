{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileCategories": {
    "server-upload": {
      "PathTemplate": "server/{guid}${ext}",
      "MaxLength": 10485760,
      "Metadata": {
        "description": "服务端中转上传示例"
      },
      "Mode": "Server"
    },
    "client-upload": {
      "PathTemplate": "client/{guid}",
      "MaxLength": 52428800,
      "Metadata": {
        "description": "客户端直传示例"
      },
      "Mode": "Client"
    }
  },
  "Upload": {
    "UploadRootFolder": "upload",
    "PublicPoint": null
  }
}
