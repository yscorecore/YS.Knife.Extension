<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
        <!-- 规避 .NET 11 preview SDK 的 StaticWebAssets JSModules 构建错误 -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="wwwroot\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="YS.Knife.Hosting.Web" Version="2.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\YS.Knife.FileStorage.CategoryProvider.Default\YS.Knife.FileStorage.CategoryProvider.Default.csproj" />
      <ProjectReference Include="..\..\src\YS.Knife.FileStorage.Default\YS.Knife.FileStorage.Default.csproj" />
      <ProjectReference Include="..\..\src\YS.Knife.FileStorage.Impl.Local\YS.Knife.FileStorage.Impl.Local.csproj" />
      <ProjectReference Include="..\..\src\YS.Knife.FileStorage.SystemArguments.Default\YS.Knife.FileStorage.SystemArguments.Default.csproj" />
      <ProjectReference Include="..\..\src\YS.Knife.Generators.ExposeApi\YS.Knife.Generators.ExposeApi.csproj">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <OutputItemType>Analyzer</OutputItemType>
      </ProjectReference>
    </ItemGroup>

</Project>
