# —— 换行符策略 ——
# 仓库内统一存 LF，避免跨平台 diff 噪音和混合换行符。
# 需要 CRLF 的脚本类文件（.ps1/.bat/.cmd）在下面单独声明。
* text=auto eol=lf

# Shell 脚本（Git Bash / WSL / CI）必须 LF
*.sh		text eol=lf
*.bash		text eol=lf

# Windows 脚本：CRLF 才能被 cmd.exe / PowerShell 正确识别
*.ps1		text eol=crlf
*.psm1		text eol=crlf
*.psd1		text eol=crlf
*.bat		text eol=crlf
*.cmd		text eol=crlf

# —— 编码 ——
# .editorconfig 已规定 UTF-8-BOM / UTF-8，这里只标注二进制避免误转
*.png		binary
*.jpg		binary
*.jpeg		binary
*.gif		binary
*.ico		binary
*.pdf		binary
*.zip		binary
*.7z		binary
*.dll		binary
*.exe		binary
*.pdb		binary
*.nupkg		binary
